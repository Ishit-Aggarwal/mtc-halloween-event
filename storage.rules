rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /submissions/{teamKey}/{allPaths=**} {
      // Anyone can read submissions (judges and teams)
      allow read: if true;
      // Authenticated (including anonymous) users can upload their team zip submission (max 50MB)
      allow write: if request.auth != null
                   && request.resource.size < 50 * 1024 * 1024;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
